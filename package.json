{
  "name": "vhs-editor",
  "version": "0.1.0",
  "productName": "90s Craig Edit Booth",
  "description": "Find and remove commercials from digitized VHS tapes, restore the picture and sound, and export a clean copy or vertical social clips.",
  "main": "main.js",
  "author": "90sCraig",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "setup-ffmpeg": "node scripts/setup-ffmpeg.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "build": {
    "appId": "com.90scraig.editbooth",
    "productName": "90s Craig Edit Booth",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "asar": true,
    "files": [
      "**/*",
      "!**/node_modules/ffprobe-static/bin/darwin/**",
      "!**/node_modules/ffprobe-static/bin/linux/**",
      "!**/node_modules/ffprobe-static/bin/win32/ia32/**"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/ffmpeg.exe",
      "node_modules/ffprobe-static/bin/win32/x64/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "90s Craig Edit Booth"
    }
  }
}
